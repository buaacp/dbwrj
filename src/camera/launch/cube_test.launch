<!-- 相机节点启动 -->
<launch>

  <!-- 启动 RealSense D435i 相机 -->
  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
  </include>

  <!-- 启动你的检测节点 -->
  <node pkg="camera" type="cube_position_D435i.py" name="object_detect" output="screen">
  </node>

  <node pkg="camera" type="position_filter.py" name="position_filter" output="screen">
      <!-- 平滑因子：值越小平滑效果越强，但响应越慢 -->
      <param name="alpha" value="0.4" />
      
      <!-- 最小移动距离阈值：小于此值的移动会被更强地平滑 -->
      <param name="min_distance_threshold" value="0.05" />
  </node>

  <!-- 启动 RViz 可视化 -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find camera)/rviz/d435_frame.rviz" output="screen">
  </node>
  
</launch>
