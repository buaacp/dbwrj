<launch>
    <arg name="target_topic" default="/weightless_ball/pose"/>
    <arg name="ball_target_topic" default="/weightless_ball/pose"/>
    <arg name="bulb_target_topic" default="/light_bulb/body_pose"/>
    <arg name="socket_target_topic" default="/light_bulb_fixture/socket_pose"/>
    <arg name="approach_angle_deg" default="0.0"/>
    <arg name="approach_distance" default="0.0"/>
    <arg name="target_height_offset" default="0.36"/>
    <arg name="face_target" default="true"/>
    <arg name="target_yaw_deg" default=""/>
    <arg name="hover_yaw_deg" default=""/>
    <arg name="ball_yaw_deg" default=""/>
    <arg name="bulb_yaw_deg" default=""/>
    <arg name="socket_yaw_deg" default=""/>

    <node
        pkg="test_fly"
        type="test_velocity_control.py"
        name="test_velocity_control"
        output="screen">
        <!-- mission_state: 0 悬停点, 1 小球, 2 灯泡, 3 灯座 -->
        <param name="target_topic" value="$(arg target_topic)"/>
        <param name="ball_target_topic" value="$(arg ball_target_topic)"/>
        <param name="bulb_target_topic" value="$(arg bulb_target_topic)"/>
        <param name="socket_target_topic" value="$(arg socket_target_topic)"/>
        <!-- 方位角定义为目标点到无人机期望位置的 ENU 平面角，0 表示 +X 方向 -->
        <param name="approach_angle_deg" value="$(arg approach_angle_deg)"/>
        <param name="approach_distance" value="$(arg approach_distance)"/>
        <param name="target_height_offset" value="$(arg target_height_offset)"/>
        <!-- target_yaw_deg 留空时默认朝向目标点；如需固定航向可在命令行覆盖 -->
        <param name="face_target" value="$(arg face_target)"/>
        <param name="target_yaw_deg" value="$(arg target_yaw_deg)"/>
        <!-- 单独指定各任务期望航向，优先级高于 target_yaw_deg；单位 deg，留空则走默认逻辑 -->
        <param name="hover_yaw_deg" value="$(arg hover_yaw_deg)"/>
        <param name="ball_yaw_deg" value="$(arg ball_yaw_deg)"/>
        <param name="bulb_yaw_deg" value="$(arg bulb_yaw_deg)"/>
        <param name="socket_yaw_deg" value="$(arg socket_yaw_deg)"/>
    </node>
    <node
        pkg="test_fly"
        type="get_local_pose.py"
        name="get_local_pose"
        output="screen">
    </node>
    <node
        pkg="test_fly"
        type="mission_control.py"
        name="mission_control"
        output="screen">
    </node>
</launch>
